{
  "manifest_version": 3,
  "name": "My Awesome Extension",
  "version": "1.0.0",
  "description": "An awesome browser extension that does amazing things.",
  "permissions": ["storage", "tabs"],
  "background": {
    "scripts": ["src/background.jsx"]
  },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content.jsx"]
    }
  ]
}
