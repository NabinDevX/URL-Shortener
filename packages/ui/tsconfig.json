{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@repo/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
