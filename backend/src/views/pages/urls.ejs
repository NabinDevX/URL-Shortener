    font-weight: 600;
    margin-bottom: 20px;
  }

  .urls-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .url-item {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 25px;
    border-left: 5px solid #667eea;
    transition: all 0.3s ease;
  }

  .url-item:hover {
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transform: translateX(5px);
  }

  .url-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
    gap: 15px;
  }

  .url-info {
    flex: 1;
    min-width: 0;
  }

