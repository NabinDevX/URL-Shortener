<div class="urls-container">
  <div class="urls-card">
    <div class="header-section">
      <div>
        <h1 class="urls-title">Manage URLs</h1>
        <p class="urls-subtitle">Create, view analytics, and manage your short URLs</p>
      </div>
      <button class="btn btn-secondary" onclick="window.location.href='/dashboard'">
        ← Dashboard
      </button>
    </div>

    <!-- Create URL Form -->
    <div class="create-section">
      <h2>Create New Short URL</h2>
      <form id="urlForm" class="url-form">
        <div class="form-row">
          <div class="form-group">
            <label for="url">Original URL *</label>
            <input 
              type="url" 
              id="url" 
              name="url" 
              placeholder="https://example.com/very/long/url" 
              required
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="customShortId">Custom Short ID (Optional)</label>
            <input 
              type="text" 
              id="customShortId" 
              name="customShortId" 
              placeholder="my-custom-link" 
              pattern="[a-zA-Z0-9_-]+"
              minlength="3"
              maxlength="20"
            />
            <small class="hint">3-20 characters, letters, numbers, hyphens, underscores</small>
          </div>

          <div class="form-group">
            <label for="idLength">Random ID Length</label>
            <input 
              type="number" 
              id="idLength" 
              name="idLength" 
              value="8"
              min="4" 
              max="15"
            />
            <small class="hint">Used only if no custom ID (4-15 chars)</small>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" id="submitBtn">
          <span class="btn-text">Generate Short URL</span>
        </button>

        <div id="message" class="message"></div>
      </form>

      <div id="resultSection" class="result-section" style="display: none;">
        <h3>✓ Short URL Created!</h3>
        <div class="short-url-display">
          <input type="text" id="shortUrlInput" readonly />
          <button onclick="copyShortUrl()" class="btn-copy">📋 Copy</button>
        </div>
        <div class="url-details">
          <p><strong>Short ID:</strong> <span id="shortIdDisplay"></span></p>
          <p><strong>Redirects to:</strong> <span id="originalUrlDisplay"></span></p>
        </div>
      </div>
    </div>

    <!-- URLs List Section -->
    <div class="list-section">
      <div class="list-header">
        <h2>Your URLs</h2>
        <button class="btn-refresh" onclick="loadUrls()">🔄 Refresh</button>
      </div>

      <div id="loading" class="loading-state">
        <div class="spinner"></div>
        <p>Loading your URLs...</p>
      </div>

      <div id="error" class="error-state" style="display: none;">
        <p id="error-text"></p>
        <button class="btn btn-secondary" onclick="loadUrls()">Retry</button>
      </div>

      <div id="urlsList" class="urls-list"></div>

      <div id="noUrls" class="no-urls" style="display: none;">
        <span class="empty-icon">📭</span>
        <h3>No URLs yet</h3>
        <p>Create your first short URL using the form above!</p>
      </div>
    </div>
  </div>
</div>

<style>
