<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head') %>
  <body>
    <div class="app-wrapper">
      <main class="main-content">
        <%- body %>
      </main>

      <footer class="site-footer">
        <%- include('./partials/footer') %>
      </footer>
    </div>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        height: 100%;
        font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }

      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #333;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .app-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        width: 100%;
      }

      .main-content {
        flex: 1;
        width: 100%;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .site-footer {
        margin-top: auto;
        width: 100%;
        padding: 20px;
        text-align: center;
        background: rgba(0, 0, 0, 0.1);
        color: #fff;
      }

      @media (max-width: 768px) {
        .main-content {
          padding: 15px;
        }
        
        .site-footer {
          padding: 15px;
        }
      }
    </style>
  </body>
</html>
