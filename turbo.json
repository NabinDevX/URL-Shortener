{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CAPACITOR_SERVER_URL",
    "PORT",
    "NODE_ENV",
    "CORS_ORIGIN",
    "MONGODB_URI",
    "DB_NAME",
    "REDIS_URL",
    "CORS_ORIGIN",
    "USER_SECRET_ACCESS_TOKEN",
    "USER_SECRET_REFRESH_TOKEN",
    "ACCESS_TOKEN_EXPIRY",
    "REFRESH_TOKEN_EXPIRY",
    "API_KEY_RATE_LIMIT_REQUESTS",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX_REQUESTS",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "BREVO_SENDER_EMAIL",
    "BREVO_API_KEY",
    "OTP_EMAIL_IN_NON_PRODUCTION",
    "PRODUCTION_DOMAIN",
    "LOG_LEVEL",
    "LOKI_HOST",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID",
    "GOOGLE_WEB_CLIENT_SECRET",
    "NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID",
    "VITE_API_PREFIX",
    "VITE_API_BASE_URL",
    "VITE_GOOGLE_CLIENT_ID",
    "JEST_WORKER_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "envMode": "loose",
      "with": ["dev:css"]
    },
    "dev:css": {
      "cache": false,
      "persistent": true,
      "envMode": "loose"
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}
