{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js",
    "verbose": false
  },
  "include": ["src"],
  "exclude": ["tests", "**/*.spec.ts", "**/*.test.ts"]
}
