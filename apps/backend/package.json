{
  "name": "@repo/backend",
  "version": "1.0.0",
  "description": "URL shortener backend with Express and tRPC.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css",
    "start:production": "node dist/index.js",
    "start": "dotenv -- node dist/index.js",
    "dev": "dotenv -- tsx watch src/index.ts",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "@trpc/server": "^11.8.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "mongoose-unique-validator": "^4.0.1",
    "nanoid": "^5.1.6",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^9.1.1",
    "razorpay": "^2.9.6",
    "redis": "^5.8.3",
    "trpc-to-openapi": "^3.1.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/cli": "^4.2.2",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.0.0",
    "gcp-metadata": "^7.0.1",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.16",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
