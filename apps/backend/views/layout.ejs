<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head') %>

<body class="bg-surface font-body text-on-surface">
  <div class="min-h-screen">
    <% const appPages = ['dashboard', 'urls', 'analytics', 'campaigns', 'api', 'settings', 'profile']; %>
    <% const currentPage = locals.currentPage || ''; %>
    <% const showAppShell = appPages.includes(currentPage); %>
    <% const pageTitleMap = { dashboard: 'Dashboard', urls: 'Manage URLs', analytics: 'Analytics', campaigns: 'Campaigns', api: 'API Management', settings: 'Settings', profile: 'My Profile' }; %>
    <% const searchPlaceholderMap = { dashboard: 'Search links...', urls: 'Search URLs...', analytics: 'Search links...', campaigns: 'Search campaigns...', api: 'Search API docs...', settings: 'Search settings...', profile: 'Search profile...' }; %>
    <% const showPlanBadge = ['dashboard', 'urls', 'analytics'].includes(currentPage); %>

    <% if (showAppShell) { %>
    <div class="min-h-screen lg:flex" data-shell="app" id="appShell">
      <%- include('./partials/sidebar', { activePage: currentPage }) %>

      <div class="flex min-h-screen min-w-0 flex-1 flex-col" id="appShellMain">
        <%- include('./partials/header', { pageTitle: pageTitleMap[currentPage], searchPlaceholder: searchPlaceholderMap[currentPage], showPlanBadge, authUser: locals.authUser }) %>

        <main class="flex-1 overflow-x-auto pb-24 lg:pb-0">
          <%- body %>
        </main>

        <%- include('./partials/footer-app') %>
      </div>

      <%- include('./partials/mobile-nav', { currentPage }) %>
    </div>
    <% } else { %>
    <div data-shell="public" id="publicShell">
      <main id="publicMain">
        <%- body %>
      </main>

      <%- include('./partials/footer') %>
    </div>
    <% } %>
  </div>
</body>

</html>