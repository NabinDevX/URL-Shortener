<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head') %>

<body class="bg-surface font-body text-on-surface flex flex-col h-screen">
  <% const currentPage = locals.currentPage || ''; %>
  <div class="<% if (currentPage === 'welcome') { %>flex-1 flex flex-col h-full<% } else { %>min-h-screen<% } %>">
    <% const appPages = ['dashboard', 'urls', 'analytics', 'campaigns', 'api', 'settings', 'profile']; %>
    <% const showAppShell = appPages.includes(currentPage); %>
    <% const pageTitleMap = { dashboard: 'Dashboard', urls: 'Manage URLs', analytics: 'Analytics', campaigns: 'Campaigns', api: 'API Management', settings: 'Settings', profile: 'My Profile' }; %>
    <% const searchPlaceholderMap = { dashboard: 'Search links...', urls: 'Search URLs...', analytics: 'Search links...', campaigns: 'Search campaigns...', api: 'Search API docs...', settings: 'Search settings...', profile: 'Search profile...' }; %>
    <% const showPlanBadge = ['dashboard', 'urls', 'analytics'].includes(currentPage); %>

    <% if (showAppShell) { %>
    <div class="min-h-screen lg:flex" data-shell="app" id="appShell">
      <%- include('./partials/sidebar', { activePage: currentPage }) %>

      <div class="flex min-h-screen min-w-0 flex-1 flex-col" id="appShellMain">
        <%- include('./partials/header', { pageTitle: pageTitleMap[currentPage], searchPlaceholder: searchPlaceholderMap[currentPage], showPlanBadge, authUser: locals.authUser }) %>

        <main class="flex-1 overflow-x-auto pb-24 lg:pb-0">
          <%- body %>
        </main>

        <%- include('./partials/footer-app') %>
      </div>

      <%- include('./partials/mobile-nav', { currentPage }) %>
    </div>
    <% } else { %>
    <div data-shell="public" id="publicShell" class="<% if (currentPage === 'welcome') { %>flex-1 flex flex-col h-full<% } %>">
      <main id="publicMain" class="<% if (currentPage === 'welcome') { %>flex-1 flex flex-col<% } %>">
        <%- body %>
      </main>

      <% if (currentPage !== 'welcome') { %>
      <%- include('./partials/footer') %>
      <% } %>
    </div>
    <% } %>
  </div>

  <% if (process.env.NODE_ENV !== 'development') { %>
  <script>
    const originalTitle = document.title;

    const messages = [
      "👀 Hey, where are you?",
      "⬅️ Come back!",
      "🥺 Don’t leave this tab!",
      "✨ This tab needs you!"
    ];

    let index = 0;
    let loopInterval = null;

    function startLoop() {
      if (loopInterval) return;
      loopInterval = setInterval(() => {
        document.title = messages[index];
        index = (index + 1) % messages.length;
      }, 1000);
    }

    function stopLoop() {
      clearInterval(loopInterval);
      loopInterval = null;
      document.title = originalTitle;
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) startLoop();
      else stopLoop();
    });
  </script>

  <script>
    const isLocalhost =
      location.hostname === "localhost" ||
      location.hostname === "127.0.0.1";

    if (!isLocalhost) {

      document.addEventListener("contextmenu", e => e.preventDefault());

      document.addEventListener("keydown", function(e) {
        if (
          e.key === "F12" ||
          (e.ctrlKey && e.shiftKey && ["I", "J", "C"].includes(e.key)) ||
          (e.ctrlKey && e.key === "U")
        ) {
          e.preventDefault();
        }
      });

      setInterval(function() {
        if (
          window.outerWidth - window.innerWidth > 160 ||
          window.outerHeight - window.innerHeight > 160
        ) {
          console.clear();
          document.body.innerHTML = "";
        }
      }, 1000);
    }
  </script>
  <% } %>

</body>

</html>