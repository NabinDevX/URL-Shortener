<div class="mx-auto max-w-7xl space-y-12 p-8 lg:p-12 intro-reveal">
  <div class="rounded-3xl bg-surface-container-lowest p-8 shadow-sm lg:p-10 reveal-on-scroll" data-reveal>
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="font-headline text-3xl font-extrabold text-on-surface">Manage URLs</h1>
        <p class="text-on-surface-variant">Create, view analytics, and manage your short URLs</p>
      </div>
      <button id="urlsDashboardBtn" class="btn btn-secondary" type="button">← Dashboard</button>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-stretch">
      <div class="rounded-2xl bg-surface-container-low p-6 reveal-on-scroll hover-float lg:sticky lg:top-24 lg:h-110 lg:self-start lg:overflow-y-auto" data-reveal>
        <h2 class="mb-6 font-headline text-2xl font-bold text-on-surface">Create New Short URL</h2>
        <form id="urlForm" class="space-y-6">
          <div class="space-y-2">
            <label for="url" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Original URL *</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">link</span>
              <input class="h-12 w-full rounded-xl border border-outline-variant/30 bg-surface-container-lowest pl-11 pr-4 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" type="url" id="url" name="url" placeholder="https://example.com/very/long/url" required />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="customShortId" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Custom Short ID (Optional)</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">tag</span>
                <input class="h-12 w-full rounded-xl border border-outline-variant/30 bg-surface-container-lowest pl-11 pr-4 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" type="text" id="customShortId" name="customShortId" placeholder="my-custom-link" pattern="[a-zA-Z0-9_-]+" minlength="3" maxlength="20" />
              </div>
              <small class="text-xs text-on-surface-variant">3-20 characters, letters, numbers, hyphens, underscores</small>
            </div>

            <div class="space-y-2">
              <label for="idLength" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Random ID Length</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">straighten</span>
                <input class="h-12 w-full rounded-xl border border-outline-variant/30 bg-surface-container-lowest pl-11 pr-4 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" type="number" id="idLength" name="idLength" value="8" min="4" max="15" />
              </div>
              <small class="text-xs text-on-surface-variant">Used only if no custom ID (4-15 chars)</small>
            </div>
          </div>

          <button type="submit" class="inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-bold text-on-primary transition-colors hover:bg-primary-container" id="submitBtn">
            <span class="material-symbols-outlined text-base">bolt</span>
            <span class="btn-text">Generate Short URL</span>
          </button>

          <div id="message" class="rounded-xl px-3 py-2 text-sm text-on-surface-variant"></div>
        </form>

        <div id="resultSection" class="mt-6 rounded-2xl border border-primary/20 bg-surface-container-lowest p-4" style="display: none;">
          <h3 class="mb-3 inline-flex items-center gap-2 text-sm font-bold text-primary">
            <span class="material-symbols-outlined text-base">check_circle</span>
            Short URL Created
          </h3>
          <div class="flex flex-col gap-3 sm:flex-row">
            <input class="h-11 w-full rounded-xl border border-outline-variant/30 bg-surface-container-low px-3 text-sm text-on-surface" type="text" id="shortUrlInput" readonly />
            <button id="copyShortUrlBtn" type="button" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-surface-container-high px-4 text-sm font-bold text-on-surface transition-colors hover:bg-surface-container-highest">
              <span class="material-symbols-outlined text-base">content_copy</span>
              Copy
            </button>
          </div>
          <div class="mt-3 space-y-1 text-sm text-on-surface-variant">
            <p><strong class="text-on-surface">Short ID:</strong> <span id="shortIdDisplay"></span></p>
            <p><strong class="text-on-surface">Redirects to:</strong> <span id="originalUrlDisplay"></span></p>
          </div>
        </div>
      </div>

      <div class="rounded-2xl bg-surface-container-low p-6 reveal-on-scroll hover-float lg:h-110 lg:overflow-hidden" data-reveal>
        <div class="list-header mb-6 flex items-center justify-between">
          <div>
            <h2 class="font-headline text-2xl font-bold text-on-surface">Your URLs</h2>
            <p id="urlsSummary" class="text-sm text-on-surface-variant">Manage and monitor all your shortened links</p>
          </div>
          <button id="refreshUrlsBtn" class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-surface-container-high px-4 text-sm font-bold text-on-surface transition-colors hover:bg-surface-container-highest" type="button">
            <span class="material-symbols-outlined text-base">refresh</span>
            Refresh
          </button>
        </div>

        <div class="space-y-4 lg:h-[calc(100%-4.5rem)] lg:overflow-y-auto lg:overscroll-contain lg:pr-1">
          <div id="loading" class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-4 text-sm text-on-surface-variant">
            Loading your URLs...
          </div>

          <div id="error" class="rounded-xl border border-error/20 bg-error-container p-4" style="display: none;">
            <p id="error-text" class="text-sm text-error"></p>
            <button id="retryUrlsBtn" class="mt-3 inline-flex h-10 items-center justify-center rounded-xl bg-surface-container-high px-4 text-sm font-bold text-on-surface transition-colors hover:bg-surface-container-highest" type="button">Retry</button>
          </div>

          <div id="urlsList" class="space-y-4"></div>

          <div id="noUrls" class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-6 text-center" style="display: none;">
            <span class="material-symbols-outlined mx-auto mb-2 text-3xl text-on-surface-variant">link_off</span>
            <h3 class="text-lg font-bold text-on-surface">No URLs yet</h3>
            <p class="text-sm text-on-surface-variant">Create your first short URL using the form.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/urls.js" defer></script>