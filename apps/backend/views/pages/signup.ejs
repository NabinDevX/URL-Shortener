<section id="signup-root" data-google-client-id="<%= process.env.GOOGLE_CLIENT_ID || '' %>" class="relative min-h-screen overflow-hidden px-6 py-12 lg:px-10 lg:py-16">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -left-[8%] top-[8%] h-[36%] w-[36%] rounded-full bg-primary/10 blur-[120px]"></div>
    <div class="absolute -bottom-[10%] right-[0%] h-[34%] w-[34%] rounded-full bg-indigo-900/10 blur-[120px]"></div>
  </div>

  <main class="relative z-10 mx-auto grid w-full max-w-300 grid-cols-1 items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div class="hidden max-w-xl lg:flex lg:flex-col lg:space-y-8 lg:justify-self-start">
      <div class="space-y-4">
        <div class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-primary">
          Start fast
        </div>
        <h1 class="text-5xl font-extrabold leading-[1.1] tracking-tighter text-on-surface xl:text-6xl">
          Create your account and start shortening links.
        </h1>
        <p class="max-w-md text-lg leading-relaxed text-on-surface-variant">
          Set up your URLTinier profile, verify your email with OTP, or continue with Google in one secure flow.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-outline-variant/10 bg-surface-container-low/50 p-6">
          <span class="material-symbols-outlined mb-3 text-primary">verified_user</span>
          <h3 class="font-bold text-on-surface">Verified access</h3>
          <p class="text-sm text-on-surface-variant">Email OTP and Google sign-up are both supported.</p>
        </div>
        <div class="rounded-xl border border-outline-variant/10 bg-surface-container-low/50 p-6">
          <span class="material-symbols-outlined mb-3 text-primary">bolt</span>
          <h3 class="font-bold text-on-surface">Fast setup</h3>
          <p class="text-sm text-on-surface-variant">Create your account and get to the dashboard quickly.</p>
        </div>
      </div>
    </div>

    <div class="flex w-full justify-center lg:justify-self-end intro-reveal intro-delay-1">
      <div class="obsidian-card relative w-full max-w-md overflow-hidden rounded-4xl p-8 shadow-2xl md:p-12 hover-float">
        <div class="mb-10 flex flex-col items-center text-center">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-container shadow-lg shadow-primary-container/20">
            <span class="material-symbols-outlined text-2xl font-bold text-on-primary-container">person_add</span>
          </div>
          <h2 class="mb-2 text-3xl font-black tracking-tighter text-on-surface">Create Account</h2>
          <p class="text-sm font-medium text-on-surface-variant">Sign up to your URLTinier account</p>
        </div>

        <div id="message" class="hidden mb-6 rounded-xl px-4 py-3 text-sm font-medium"></div>

        <form id="signupForm" class="space-y-6">
          <div class="space-y-2">
            <label class="block px-1 text-xs font-bold uppercase tracking-widest text-on-surface-variant" for="name">Full Name</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-lg text-outline">person</span>
              <input class="glass-input h-14 w-full rounded-xl px-4 pl-12 text-on-surface transition-all placeholder:text-outline/60" id="name" name="name" placeholder="Jane Doe" type="text" required />
            </div>
          </div>

          <div class="space-y-2">
            <label class="block px-1 text-xs font-bold uppercase tracking-widest text-on-surface-variant" for="email">Email Address</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-lg text-outline">mail</span>
              <input class="glass-input h-14 w-full rounded-xl px-4 pl-12 text-on-surface transition-all placeholder:text-outline/60" id="email" name="email" placeholder="name@company.com" type="email" required />
            </div>
          </div>

          <div class="space-y-2">
            <label class="block px-1 text-xs font-bold uppercase tracking-widest text-on-surface-variant" for="password">Password</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-lg text-outline">lock</span>
              <input class="glass-input h-14 w-full rounded-xl px-4 pl-12 text-on-surface transition-all placeholder:text-outline/60" id="password" name="password" placeholder="••••••••" type="password" required />
            </div>
          </div>

          <button id="sendOtpBtn" class="flex h-14 w-full items-center justify-center gap-2 rounded-xl bg-surface-container-highest/30 font-bold text-on-surface transition-all hover:bg-surface-container-highest/50 active:scale-[0.98]" type="button">
            Send OTP
            <span class="material-symbols-outlined text-lg">mail_lock</span>
          </button>

          <div id="otpSection" class="hidden space-y-2">
            <label class="block px-1 text-xs font-bold uppercase tracking-widest text-on-surface-variant" for="otp">OTP Code</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-lg text-outline">pin</span>
              <input class="glass-input h-14 w-full rounded-xl px-4 pl-12 text-on-surface transition-all placeholder:text-outline/60" id="otp" name="otp" inputmode="numeric" maxlength="6" placeholder="123456" type="text" />
            </div>
          </div>

          <button id="signupBtn" class="flex h-14 w-full items-center justify-center gap-2 rounded-xl bg-primary-container font-bold text-on-primary-container shadow-lg shadow-primary-container/20 transition-all hover:brightness-110 active:scale-[0.98]" type="submit" style="display: none;">
            Verify OTP & Sign Up
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
        </form>

        <div class="my-8 flex items-center gap-4">
          <div class="h-px flex-1 bg-outline-variant/20"></div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-outline">or continue with</span>
          <div class="h-px flex-1 bg-outline-variant/20"></div>
        </div>

        <button id="googleSignupBtn" type="button" class="flex h-14 w-full items-center justify-center gap-3 rounded-xl border border-outline-variant/20 bg-surface-container-highest/30 text-sm font-bold text-on-surface transition-all hover:bg-surface-container-highest/50">
          <img alt="Google" class="h-5 w-5" src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" />
          Continue with Google
        </button>

        <p class="mt-10 text-center text-xs font-medium text-on-surface-variant">
          Already have an account?
          <a class="ml-1 font-bold text-primary underline-offset-4 hover:underline" href="/signin">Sign in</a>
        </p>
      </div>
    </div>
  </main>

  <script src="https://accounts.google.com/gsi/client" defer></script>
  <script src="/js/signup.js" defer></script>
</section>