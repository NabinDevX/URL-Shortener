<div class="mx-auto max-w-6xl space-y-8 p-8 lg:p-12 intro-reveal">
  <section class="rounded-3xl bg-surface-container-lowest p-8 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="font-headline text-3xl font-extrabold text-on-surface">Custom API Key Documentation</h2>
        <p class="mt-2 text-sm text-on-surface-variant">Use your generated x-api-key to access protected URLTinier APIs.</p>
      </div>
      <a class="inline-flex items-center gap-2 rounded-xl bg-surface-container-high px-4 py-2.5 text-sm font-bold text-on-surface transition-colors hover:bg-surface-container-highest" href="/api">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Back to API Panel
      </a>
    </div>
  </section>

  <section class="rounded-2xl bg-surface-container-lowest p-8 shadow-sm">
    <h3 class="font-headline text-xl font-bold text-on-surface">Authentication Header</h3>
    <p class="mt-1 text-sm text-on-surface-variant">Include your API key in every protected request.</p>

    <div class="mt-5 rounded-xl border border-outline-variant/30 bg-black/90 p-4 text-xs text-white">
      <pre><code>x-api-key: YOUR_API_KEY</code></pre>
    </div>

    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <div class="rounded-xl border border-outline-variant/30 bg-surface-container-low p-3">
        <p class="text-[11px] font-bold uppercase tracking-wide text-on-surface-variant">Header Name</p>
        <p class="mt-1 text-sm font-bold text-on-surface">x-api-key</p>
      </div>
      <div class="rounded-xl border border-outline-variant/30 bg-surface-container-low p-3">
        <p class="text-[11px] font-bold uppercase tracking-wide text-on-surface-variant">Required</p>
        <p class="mt-1 text-sm font-bold text-on-surface">Yes (for protected routes)</p>
      </div>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl bg-surface-container-lowest p-8 shadow-sm">
      <h3 class="font-headline text-xl font-bold text-on-surface">1) Generate Short URL</h3>
      <p class="mt-1 text-sm text-on-surface-variant">Create a new short URL with your API key.</p>

      <div class="mt-5 rounded-xl border border-outline-variant/30 bg-black/90 p-4 text-xs text-white overflow-x-auto">
        <pre><code>curl -X POST "<%= process.env.BASE_URL || 'http://localhost:8000' %>/api/v1/url/shorten" \
  -H "Content-Type: application/json" \
  -H "x-api-key: YOUR_API_KEY" \
  -d '{"url":"https://example.com"}'</code></pre>
      </div>
    </div>

    <div class="rounded-2xl bg-surface-container-lowest p-8 shadow-sm">
      <h3 class="font-headline text-xl font-bold text-on-surface">2) List My URLs</h3>
      <p class="mt-1 text-sm text-on-surface-variant">Fetch paginated URLs tied to your account.</p>

      <div class="mt-5 rounded-xl border border-outline-variant/30 bg-black/90 p-4 text-xs text-white overflow-x-auto">
        <pre><code>curl -X GET "<%= process.env.BASE_URL || 'http://localhost:8000' %>/api/v1/url/my-urls?page=1&limit=10" \
  -H "x-api-key: YOUR_API_KEY"</code></pre>
      </div>
    </div>

    <div class="rounded-2xl bg-surface-container-lowest p-8 shadow-sm lg:col-span-2">
      <h3 class="font-headline text-xl font-bold text-on-surface">3) Check API Key Rate-Limit Usage</h3>
      <p class="mt-1 text-sm text-on-surface-variant">View current API key usage and reset window.</p>

      <div class="mt-5 rounded-xl border border-outline-variant/30 bg-black/90 p-4 text-xs text-white overflow-x-auto">
        <pre><code>curl -X GET "<%= process.env.BASE_URL || 'http://localhost:8000' %>/api/v1/user/api-rate-limit" \
  -H "x-api-key: YOUR_API_KEY"</code></pre>
      </div>
    </div>
  </section>

  <section class="rounded-2xl bg-surface-container-lowest p-8 shadow-sm">
    <h3 class="font-headline text-xl font-bold text-on-surface">Error Notes</h3>
    <ul class="mt-3 space-y-2 text-sm text-on-surface-variant">
      <li>401/403: Invalid or missing x-api-key.</li>
      <li>429: API key rate limit exceeded.</li>
      <li>400: Invalid request payload.</li>
    </ul>
  </section>
</div>