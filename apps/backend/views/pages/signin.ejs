<section id="signin-root" data-google-client-id="<%= process.env.GOOGLE_CLIENT_ID || '' %>" class="relative min-h-screen overflow-hidden px-6 py-12 lg:px-10 lg:py-16">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-[10%] -left-[10%] h-[40%] w-[40%] rounded-full bg-primary/10 blur-[120px]"></div>
    <div class="absolute -right-[10%] -bottom-[10%] h-[40%] w-[40%] rounded-full bg-indigo-900/20 blur-[120px]"></div>
  </div>

  <main class="relative z-10 mx-auto grid w-full max-w-300 grid-cols-1 items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div class="hidden max-w-xl lg:flex lg:flex-col lg:space-y-8 lg:justify-self-start">
      <div class="space-y-4">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold tracking-widest uppercase">
          Platform Security
        </div>
        <h1 class="text-5xl font-extrabold leading-[1.1] tracking-tighter text-on-surface xl:text-6xl">
          Control every <span class="text-transparent bg-clip-text bg-linear-to-r from-primary to-primary-container">link</span> you share.
        </h1>
        <p class="text-on-surface-variant text-lg max-w-md leading-relaxed">
          Access your shortened links, real-time analytics, and premium branding tools in one secure obsidian-themed dashboard.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="p-6 rounded-xl bg-surface-container-low/50 border border-outline-variant/10">
          <span class="material-symbols-outlined text-primary mb-3">verified_user</span>
          <h3 class="font-bold text-on-surface">Encrypted</h3>
          <p class="text-sm text-on-surface-variant">Military-grade protection for your data.</p>
        </div>
        <div class="p-6 rounded-xl bg-surface-container-low/50 border border-outline-variant/10">
          <span class="material-symbols-outlined text-primary mb-3">speed</span>
          <h3 class="font-bold text-on-surface">Ultra Fast</h3>
          <p class="text-sm text-on-surface-variant">Redirects under 100ms globally.</p>
        </div>
      </div>
    </div>

    <div class="flex w-full justify-center lg:justify-self-end intro-reveal intro-delay-1">
      <div class="obsidian-card relative w-full max-w-md overflow-hidden rounded-4xl p-8 shadow-2xl md:p-12 hover-float">
        <div class="mb-10 flex flex-col items-center text-center">
          <div class="w-12 h-12 bg-primary-container rounded-xl flex items-center justify-center mb-6 shadow-lg shadow-primary-container/20">
            <span class="material-symbols-outlined text-on-primary-container text-2xl font-bold">link</span>
          </div>
          <h2 class="text-3xl font-black tracking-tighter text-on-surface mb-2">Welcome Back</h2>
          <p class="text-on-surface-variant text-sm font-medium">Sign in to your URLTinier account</p>
        </div>

        <div id="message" class="hidden mb-6 rounded-xl px-4 py-3 text-sm font-medium"></div>

        <form id="signinForm" class="space-y-6">
          <div class="space-y-2">
            <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant px-1" for="email">Email Address</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">mail</span>
              <input class="glass-input w-full h-14 pl-12 pr-4 rounded-xl text-on-surface placeholder:text-outline/60 transition-all" id="email" name="email" placeholder="name@company.com" type="email" required />
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex justify-between items-center px-1">
              <label class="text-xs font-bold uppercase tracking-widest text-on-surface-variant" for="password">Password</label>
            </div>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">lock</span>
              <input class="glass-input w-full h-14 pl-12 pr-4 rounded-xl text-on-surface placeholder:text-outline/60 transition-all" id="password" name="password" placeholder="••••••••" type="password" required />
            </div>
          </div>

          <button id="signinBtn" class="w-full h-14 bg-primary-container text-on-primary-container font-bold rounded-xl hover:brightness-110 active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary-container/20" type="submit">
            Sign In
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
        </form>

        <div class="my-8 flex items-center gap-4">
          <div class="h-px flex-1 bg-outline-variant/20"></div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-outline">or continue with</span>
          <div class="h-px flex-1 bg-outline-variant/20"></div>
        </div>

        <button id="googleSigninBtn" type="button" class="h-14 w-full rounded-xl bg-surface-container-highest/30 border border-outline-variant/20 flex items-center justify-center gap-3 text-sm font-bold text-on-surface hover:bg-surface-container-highest/50 transition-all">
          <img alt="Google" class="w-5 h-5" src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" />
          Continue with Google
        </button>

        <p class="mt-10 text-center text-xs text-on-surface-variant font-medium">
          New to URLTinier?
          <a class="text-primary font-bold hover:underline underline-offset-4 ml-1" href="/signup">Create an account</a>
        </p>
      </div>
    </div>
  </main>
</section>

<script src="https://accounts.google.com/gsi/client" defer></script>
<script src="/js/signin.js" defer></script>