<div class="mx-auto max-w-5xl p-8 lg:p-12">
  <div class="rounded-3xl bg-surface-container-lowest p-8 shadow-sm lg:p-10">
    <div class="mb-8 flex items-center gap-4">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
        <span class="material-symbols-outlined text-2xl">person</span>
      </div>
      <div>
        <h1 class="font-headline text-3xl font-extrabold text-on-surface">My Profile</h1>
        <p class="text-sm text-on-surface-variant">Manage your account details and sign out when needed.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="md:col-span-1 rounded-2xl bg-surface-container-low p-6 text-center">
        <div class="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-3xl bg-primary-fixed text-primary-fixed-variant">
          <span class="avatar-icon text-5xl">👤</span>
        </div>
        <button id="changePhotoBtn" class="text-xs font-bold uppercase tracking-wider text-primary hover:text-primary-container transition-colors">Change Photo</button>
      </div>

      <div class="md:col-span-2 space-y-6 rounded-2xl bg-surface-container-low p-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Name</span>
            <div class="rounded-xl bg-white px-4 py-3 text-sm text-on-surface shadow-sm" id="userName">Loading...</div>
          </div>
          <div class="space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Email</span>
            <div class="rounded-xl bg-white px-4 py-3 text-sm text-on-surface shadow-sm" id="userEmail">Loading...</div>
          </div>
          <div class="space-y-2 sm:col-span-2">
            <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Member Since</span>
            <div class="rounded-xl bg-white px-4 py-3 text-sm text-on-surface shadow-sm" id="memberSince">Loading...</div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <button id="backToDashboardBtn" class="btn btn-primary" type="button">← Back to Dashboard</button>
          <button id="profileSettingsBtn" class="btn btn-primary" type="button">Profile Settings</button>
          <button id="profileSignoutBtn" class="btn btn-danger" type="button">Logout</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/profile.js" defer></script>