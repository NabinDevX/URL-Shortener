{
  "extends": "@repo/typescript-config/vite.json",
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@repo/*": ["../../packages/*/src"]
    }
  },
  "include": [
    "src/**/*",
    "src/vite-env.d.ts",
    "manifest.json",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
