{
  "extends": "@repo/typescript-config/vite.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/*": ["../../packages/*/src"]
    }
  },
  "include": ["src/**/*", "manifest.json", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
